rules_version = '2';

/**
 * Firestore Security Rules — 미사금빛 매물 도우미
 *
 * 핵심 원칙:
 *  1) 로그인한 사용자만 접근
 *  2) 사용자 본인은 자기 user 문서만 읽고 쓸 수 있음
 *  3) 사무실(agency)은 멤버만 읽고 쓸 수 있음
 *  4) 계약(contracts)은 그 사무실 멤버만 접근 가능
 *  5) 다른 사무실 ID를 알아도 접근 불가능 (서버에서 강제)
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // 전역 관리자 — 사용량 분석을 위해 전체 읽기 가능
    function isGlobalAdmin() {
      return request.auth != null && request.auth.token.email == "vpfldh87@gmail.com";
    }

    // ── 사용자 본인 문서 ─────────────────────────
    match /users/{userId} {
      // 본인은 읽기/쓰기, 관리자는 전체 읽기 (유저 현황 조회)
      allow read: if (request.auth != null && request.auth.uid == userId) || isGlobalAdmin();
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── 사무실 ──────────────────────────────────
    match /agencies/{agencyId} {
      // 초대 코드 합류 — 비멤버가 "본인 uid만 추가" 할 때만 허용
      //  · 유효한 초대 코드(이 사무실 것 + 만료 전)여야 함
      //  · members·memberInfo·joinCode 외 다른 칸은 못 건드림 (owner·사무소 이름 등 보호)
      function isSelfJoin() {
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode));
        return request.auth != null
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "memberInfo", "joinCode"])
               && request.resource.data.members.hasAll(resource.data.members)
               && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet()
               && request.resource.data.joinCode is string
               && invite.data.agencyId == agencyId
               && invite.data.expiresAt is number
               && invite.data.expiresAt > request.time.toMillis();
      }

      // 대표(owner)의 수정 — 대표는 계속 멤버여야 함
      function isOwnerUpdate() {
        return request.auth != null
               && request.auth.uid == resource.data.owner
               && request.resource.data.owner in request.resource.data.members;
      }

      // 직원(파트너)의 수정 — 자기 memberInfo 기록, 또는 본인 탈퇴만
      function isPartnerUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let before = resource.data.members.toSet();
        let after = request.resource.data.members.toSet();
        return request.auth != null
               && request.auth.uid in resource.data.members
               && request.auth.uid != resource.data.owner
               && changed.hasOnly(["memberInfo", "members"])
               && (after == before || (before.difference(after) == [request.auth.uid].toSet() && after.difference(before).size() == 0))
               && (!("memberInfo" in changed)
                   || request.resource.data.memberInfo.diff(resource.data.get("memberInfo", {})).affectedKeys().hasOnly([request.auth.uid]));
      }

      // 멤버 또는 관리자 읽기
      allow read: if (request.auth != null && request.auth.uid in resource.data.members) || isGlobalAdmin();
      allow update: if isOwnerUpdate() || isPartnerUpdate() || isSelfJoin();

      // 생성: 본인을 owner + members에 넣어서만 가능
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.owner
                    && request.auth.uid in request.resource.data.members;

      // 삭제: owner만
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.owner;

      // 멤버 체크 헬퍼 (사무실 안의 모든 서브컬렉션에서 공유)
      function isMember() {
        return request.auth != null
               && request.auth.uid in get(/databases/$(database)/documents/agencies/$(agencyId)).data.members;
      }
      // 대표 체크 — 데이터 등록·수정·삭제는 대표만 (직원=보기 전용)
      function isAgencyOwner() {
        return request.auth != null
               && get(/databases/$(database)/documents/agencies/$(agencyId)).data.owner == request.auth.uid;
      }

      // ── 사무실 안의 계약 ─────────────────────
      match /contracts/{contractId} {
        allow read: if isMember() || isGlobalAdmin();
        allow create, update, delete: if isAgencyOwner();
      }

      // ── 사무실 안의 손님(CRM) ─────────────────
      match /customers/{customerId} {
        allow read: if isMember() || isGlobalAdmin();
        allow create, update, delete: if isAgencyOwner();
      }

      // ── 내 매물 ──────────────────────────────
      match /properties/{propertyId} {
        allow read: if isMember() || isGlobalAdmin();
        allow create, update, delete: if isAgencyOwner();
      }

      // ── 스케줄 ──────────────────────────────
      match /schedules/{scheduleId} {
        allow read: if isMember() || isGlobalAdmin();
        allow create, update, delete: if isAgencyOwner();
      }

      // ── 실거래 최고가 ────────────────────────
      match /marketPrices/{priceId} {
        allow read: if isMember() || isGlobalAdmin();
        allow create, update, delete: if isAgencyOwner();
      }

    }

    // ── 초대 코드 (직원 합류용) ──────────────────
    match /invites/{code} {
      // 코드를 아는 로그인 사용자는 조회 가능 (합류 절차)
      allow read: if request.auth != null;
      // 생성: 해당 사무실 owner만, 만료 시각(최대 7일) 필수
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.createdBy
                    && request.resource.data.expiresAt is number
                    && request.resource.data.expiresAt <= request.time.toMillis() + 7 * 24 * 60 * 60 * 1000 + 60000
                    && get(/databases/$(database)/documents/agencies/$(request.resource.data.agencyId)).data.owner == request.auth.uid;
      // 삭제: 발급자, 또는 이 코드로 합류하는 사람 (1회용 — 합류와 같은 batch 에서 삭제)
      allow delete: if request.auth != null
                    && (resource.data.createdBy == request.auth.uid
                        || request.auth.uid in getAfter(/databases/$(database)/documents/agencies/$(resource.data.agencyId)).data.members);
    }

    // ── 전역 건의함 (agency 밖, 단 documents 블록 안에 있어야 적용됨) ──
    match /feedback/{feedbackId} {
      // 관리자 헬퍼
      function isAdmin() {
        return request.auth != null && request.auth.token.email == "vpfldh87@gmail.com";
      }
      // 본인 글 헬퍼
      function isOwner() {
        return request.auth != null && resource.data.submittedBy.uid == request.auth.uid;
      }

      // 로그인 사용자 누구나 자기 uid로 등록 가능
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.submittedBy.uid;

      // 관리자는 전체 조회, 일반 사용자는 본인 것만
      allow read: if isAdmin() || isOwner();

      // 관리자는 답변·상태 변경, 본인은 삭제
      allow update: if isAdmin() || isOwner();
      allow delete: if isAdmin() || isOwner();
    }
  }
}
